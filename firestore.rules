rules_version = '2';

// School Bus Transit — Firestore security rules.
//
// Access model: every user has a `users/{uid}` profile with `role`
// ("director" | "staff") and `schoolId`. Directors administer their school's
// students/buses/driver-codes; staff operate runs (bus monitors). All data is
// scoped under `schools/{schoolId}`, so one school can never read another's
// data.
//
// Driver access codes live in `schools/{schoolId}/driverCodes/{driverUid}`,
// readable/writable ONLY by that school's director — a driver must not read a
// colleague's code. Code verification (login) is server-side via the Admin SDK,
// which bypasses these rules.
//
// The first director + seed data are created by scripts/seed.mjs (Admin SDK,
// bypasses rules). Anyone authenticated but without a profile is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isDirector() {
      return isSignedIn() && role() == 'director';
    }

    function isStaff() {
      return isSignedIn() && role() == 'staff';
    }

    function schoolId() {
      return userDoc().data.schoolId;
    }

    function isMySchool(schoolId) {
      return isSignedIn() && schoolId() == schoolId;
    }

    // ── users ──────────────────────────────────────────────────────────────
    // A user may read their own profile; a director may additionally read any
    // profile of their own school (for the staff list). Everyone else is denied
    // — so a staff user can never read another user's profile. A user may create
    // their own profile and update their own ONLY if role/schoolId are unchanged
    // — otherwise an attacker could self-promote to director or switch tenants
    // (role/schoolId are the authorization gates everywhere below). Client code
    // never writes users/{uid}; profiles come from Admin SDK code (seed + routes).
    match /users/{uid} {
      allow read: if request.auth.uid == uid
        || (isDirector() && resource.data.schoolId == schoolId());
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if false;
    }

    // ── schools ────────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if isMySchool(schoolId);
      allow write: if isMySchool(schoolId) && isDirector();

      // Students & buses are school-administered (directors only).
      match /students/{studentId} {
        allow read: if isMySchool(schoolId);
        allow write: if isMySchool(schoolId) && isDirector();
      }

      match /buses/{busId} {
        allow read: if isMySchool(schoolId);
        allow write: if isMySchool(schoolId) && isDirector();
      }

      // Driver access codes — one doc per driver, director-only. The verify
      // route reads these via the Admin SDK (bypasses rules); the director's
      // client reads/writes them to show, copy, and regenerate codes.
      match /driverCodes/{driverUid} {
        allow read, write: if isMySchool(schoolId) && isDirector();
      }

      // Runs hold run metadata (bus, type, date, status).
      match /runs/{runId} {
        allow read: if isMySchool(schoolId);
        allow write: if isMySchool(schoolId) && (isDirector() || isStaff());
      }

      // Attendance is a flat per-school collection, one doc per
      // (run, student) — denormalized for single-query realtime reads.
      match /attendance/{attId} {
        allow read: if isMySchool(schoolId);
        allow write: if isMySchool(schoolId) && (isDirector() || isStaff());
      }
    }
  }
}
